# Copy this file to .env and fill in only what you need. .env is git-ignored.
# Never put real values in this file: it is committed to a public repository.
# Every variable is optional; an empty value means "use the default".

# Port for the local server. Default: 4310.
VALYNCE_PORT=

# Folder for the database. Default: your per-user data folder (see README).
VALYNCE_DATA_DIR=

# --- Optional AI summary ---
# Leave ANTHROPIC_API_KEY empty to keep the feature off: Valynce then sends
# nothing outside this computer. With a key, data is still sent only when you
# press "Generate summary" and confirm what will be sent. Create a key at
# https://platform.claude.com/ and paste it into your own .env, never here.
ANTHROPIC_API_KEY=

# Model used for summaries. Default: claude-sonnet-5-5.
VALYNCE_AI_MODEL=

# Seconds one summary request may take before it is abandoned. Default: 60.
VALYNCE_AI_TIMEOUT_SECONDS=

# Address of the provider's API. Default: https://api.anthropic.com.
# The confirmation shows the host your data would go to.
VALYNCE_AI_BASE_URL=

# --- Optional offline AI ---
# Needs no key. It is enabled in the app, which downloads the model once after
# you confirm the size. These two settings are rarely needed.

# Folder for the downloaded model and runtime. Default: a per-user folder
# outside this project (see docs/REFERENCE.md).
VALYNCE_AI_DIR=

# Seconds one offline summary may take, including loading the model. Default: 180.
VALYNCE_OFFLINE_AI_TIMEOUT_SECONDS=

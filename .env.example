# Copy this file to .env and fill in only what you need. .env is git-ignored.
# Never put real values in this file: it is committed to a public repository.
# Every variable is optional; an empty value means "use the default".

# Port for the local server. Default: 4310.
VALYNCE_PORT=

# Folder for the database. Default: your per-user data folder (see README).
VALYNCE_DATA_DIR=
